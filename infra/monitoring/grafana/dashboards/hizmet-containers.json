{
  "uid": "hizmet-containers",
  "title": "Hizmet - Container Kaynak Kullanımı",
  "tags": ["hizmet", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Anlık CPU (çekirdek %)",
      "description": "100 = 1 tam CPU çekirdeği (docker stats ile aynı ölçü)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (docker_container_cpu_usage_percent{container_name=~\"hizmet-.+\"})",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Anlık RAM",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (docker_container_mem_usage{container_name=~\"hizmet-.+\"})",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU kullanımı (zaman içinde)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (docker_container_cpu_usage_percent{container_name=~\"hizmet-.+\"})",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAM kullanımı (zaman içinde)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (docker_container_mem_usage{container_name=~\"hizmet-.+\"})",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network (alınan / gönderilen)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (rate(docker_container_net_rx_bytes{container_name=~\"hizmet-.+\"}[1m]))",
          "legendFormat": "{{container_name}} rx"
        },
        {
          "refId": "B",
          "expr": "sum by (container_name) (rate(docker_container_net_tx_bytes{container_name=~\"hizmet-.+\"}[1m]))",
          "legendFormat": "{{container_name}} tx"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PostgreSQL aktif bağlantılar",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname!~\"template.*\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Scrape hedefleri (1 = ayakta)",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }]
    }
  ]
}
