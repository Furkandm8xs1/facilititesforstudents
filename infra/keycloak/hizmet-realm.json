{
  "realm": "hizmet",
  "displayName": "Yurt Hizmetleri",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "portal_user",
        "description": "Yurt portalını kullanan kişi"
      },
      {
        "name": "platform_admin",
        "description": "Uygulama kullanıcılarını ve rollerini yöneten kişi"
      }
    ],
    "client": {
      "portal-api": [
        {
          "name": "canteen_operator",
          "description": "Kantin sipariş ve stok işlemlerini yönetir"
        },
        {
          "name": "canteen_manager",
          "description": "Kantin ürün ve fiyat işlemlerini yönetir"
        },
        {
          "name": "wallet_cashier",
          "description": "Nakit yükleme ve gerekçeli para düzeltmesi yapar"
        },
        {
          "name": "kitchen_operator",
          "description": "Mutfak günlük işlemlerini yönetir"
        },
        {
          "name": "kitchen_manager",
          "description": "Mutfak ayarlarını ve yönetim işlemlerini yürütür"
        },
        {
          "name": "laundry_operator",
          "description": "Çamaşırhane günlük işlemlerini yönetir"
        },
        {
          "name": "laundry_manager",
          "description": "Çamaşırhane ayarlarını ve yönetim işlemlerini yürütür"
        }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-portal-admin-service",
      "enabled": true,
      "serviceAccountClientId": "portal-admin-service",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect profile bilgileri",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "portal-api-access",
      "description": "Portal API için kullanıcı adı, rol ve audience claim'leri",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "portal-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "portal-api",
            "claim.name": "resource_access.portal-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "portal-web",
      "name": "Yurt Portalı Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "hizmet-local-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["portal-api-access"],
      "optionalClientScopes": ["profile"]
    },
    {
      "clientId": "portal-admin-service",
      "name": "Portal Kullanıcı Yönetimi Servisi",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "hizmet-local-admin-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "id": "844594e4-a183-46a3-80a7-97fdb6236d20",
      "clientId": "portal-api",
      "name": "Yurt Portalı API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}
