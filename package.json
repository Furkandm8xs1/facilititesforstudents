{
  "name": "hizmet",
  "version": "0.1.0",
  "private": true,
  "description": "Yurt hizmetleri portalı",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @hizmet/web",
    "dev:api": "npm run start:dev --workspace @hizmet/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @hizmet/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d postgres keycloak",
    "infra:down": "docker compose stop keycloak postgres",
    "infra:logs": "docker compose logs -f postgres keycloak"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
